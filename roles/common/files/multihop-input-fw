#!/usr/bin/env bash
# Manage the MULTIHOP-IN INPUT chain: allow loopback, established, SSH and
# configured ports; drop all other inbound traffic on PUBLIC_IFACE.
set -euo pipefail

MULTIHOP_ENV="${MULTIHOP_ENV:-/etc/multihop/multihop.env}"
# shellcheck disable=SC1090
. "$MULTIHOP_ENV"

CHAIN=MULTIHOP-IN
NEW=MULTIHOP-IN-NEW
: "${PUBLIC_IFACE:?PUBLIC_IFACE not set in $MULTIHOP_ENV}"
: "${SSH_PORT:=22}"
: "${INPUT_UDP_PORTS:=}"
: "${INPUT_TCP_PORTS:=}"

# Remove every jump to chain $1, then flush and delete it (if present).
drop_chain() {
  local c="$1"
  while iptables -C INPUT -j "$c" 2>/dev/null; do
    iptables -D INPUT -j "$c"
  done
  if iptables -F "$c" 2>/dev/null; then
    iptables -X "$c" 2>/dev/null || true
  fi
}

# Build a fresh chain, swap the INPUT jump to it, retire the old chain, then
# rename. INPUT is never left without the jump.
up() {
  drop_chain "$NEW"
  iptables -N "$NEW"
  iptables -A "$NEW" -i lo -j ACCEPT
  iptables -A "$NEW" -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
  iptables -A "$NEW" -p tcp --dport "$SSH_PORT" -j ACCEPT
  local p
  for p in $INPUT_UDP_PORTS; do
    iptables -A "$NEW" -p udp --dport "$p" -j ACCEPT
  done
  for p in $INPUT_TCP_PORTS; do
    iptables -A "$NEW" -p tcp --dport "$p" -j ACCEPT
  done
  iptables -A "$NEW" -i "$PUBLIC_IFACE" -j DROP
  iptables -I INPUT -j "$NEW"
  drop_chain "$CHAIN"
  iptables -E "$NEW" "$CHAIN"
}

down() {
  drop_chain "$CHAIN"
  drop_chain "$NEW"
}

case "${1:-}" in
  up) up ;;
  down) down ;;
  *) echo "usage: ${0##*/} up|down" >&2; exit 2 ;;
esac
